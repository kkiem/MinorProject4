@model List<MinorProject4.Models.Driver>
@inject MinorProject4.AppSettings Settings
@{
    ViewData["Title"] = "Drivers";
    var teams = ViewBag.Teams as List<MinorProject4.Models.Team> ?? new List<MinorProject4.Models.Team>();
    string cardClass = Settings.DarkMode ? "bg-secondary text-white border-light" : "bg-white";
}

<h2 class="mb-3">🏎️ F1 Drivers</h2>

<!-- Search Bar -->
<div class="card p-3 mb-4 @cardClass">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-8">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by Driver Name or Nationality..." />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">🔍 Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>
</div>

<!-- Add New Driver Form -->
<div class="card p-3 mb-4 @cardClass">
    <h5>➕ Add New Driver</h5>
    <form method="post" asp-action="AddDriver" class="row g-2">
        <div class="col-md-3">
            <input type="text" name="driverName" class="form-control" placeholder="Driver Name" required />
        </div>
        <div class="col-md-3">
            <input type="text" name="nationality" class="form-control" placeholder="Nationality" required />
        </div>
        <div class="col-md-2">
            <input type="number" name="carNumber" class="form-control" placeholder="Car #" required />
        </div>
        <div class="col-md-2">
            <select name="teamId" class="form-select">
                <option value="">-- No Team --</option>
                @foreach (var t in teams)
                {
                    <option value="@t.TeamID">@t.TeamName</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-success w-100">Add Driver</button>
        </div>
    </form>
</div>

<!-- Drivers Table -->
<table class="table table-bordered table-striped @(Settings.DarkMode ? "table-dark" : "")">
    <thead>
        <tr>
            <th>ID</th>
            <th>Driver Name</th>
            <th>Nationality</th>
            <th>Car #</th>
            <th>Team</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td>@d.DriverID</td>
                <form method="post">
                    <input type="hidden" name="driverId" value="@d.DriverID" />
                    <td>
                        <input type="text" name="driverName" value="@d.DriverName" class="form-control form-control-sm" required />
                    </td>
                    <td>
                        <input type="text" name="nationality" value="@d.Nationality" class="form-control form-control-sm" required />
                    </td>
                    <td style="width: 100px;">
                        <input type="number" name="carNumber" value="@d.CarNumber" class="form-control form-control-sm" required />
                    </td>
                    <td>
                        <select name="teamId" class="form-select form-select-sm">
                            <option value="">-- None --</option>
                            @foreach (var t in teams)
                            {
                                if (d.TeamID == t.TeamID)
                                {
                                    <option value="@t.TeamID" selected>@t.TeamName</option>
                                }
                                else
                                {
                                    <option value="@t.TeamID">@t.TeamName</option>
                                }
                            }
                        </select>
                    </td>
                    <td class="d-flex gap-1">
                        <button type="submit" formaction="@Url.Action("UpdateDriver", "Home")" class="btn btn-warning btn-sm">Update</button>
                        <button type="submit" formaction="@Url.Action("DeleteDriver", "Home")" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this driver?');">Delete</button>
                    </td>
                </form>
            </tr>
        }
    </tbody>
</table>