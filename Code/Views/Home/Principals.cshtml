@model List<MinorProject4.Models.Principal>
@inject MinorProject4.AppSettings Settings
@{
    ViewData["Title"] = "Principals";
    var teams = ViewBag.Teams as List<MinorProject4.Models.Team> ?? new List<MinorProject4.Models.Team>();
    string cardClass = Settings.DarkMode ? "bg-secondary text-white border-light" : "bg-white";
}

<h2 class="mb-3">👔 Team Principals</h2>

<!-- Add New Principal Form -->
<div class="card p-3 mb-4 @cardClass">
    <h5>➕ Add New Principal</h5>
    <form method="post" asp-action="AddPrincipal" class="row g-2">
        <div class="col-md-3">
            <input type="text" name="principalName" class="form-control" placeholder="Principal Name" required />
        </div>
        <div class="col-md-3">
            <input type="text" name="roleTitle" class="form-control" placeholder="Role Title" required />
        </div>
        <div class="col-md-2">
            <input type="number" name="yearsExperience" class="form-control" placeholder="Years Exp" required />
        </div>
        <div class="col-md-2">
            <select name="teamId" class="form-select">
                <option value="">-- No Team --</option>
                @foreach (var t in teams)
                {
                    <option value="@t.TeamID">@t.TeamName</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-success w-100">Add Principal</button>
        </div>
    </form>
</div>

<!-- Principals Table -->
<table class="table table-bordered table-striped @(Settings.DarkMode ? "table-dark" : "")">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Role Title</th>
            <th>Years Exp</th>
            <th>Team</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.PrincipalID</td>
                <form method="post">
                    <input type="hidden" name="principalId" value="@p.PrincipalID" />
                    <td>
                        <input type="text" name="principalName" value="@p.PrincipalName" class="form-control form-control-sm" required />
                    </td>
                    <td>
                        <input type="text" name="roleTitle" value="@p.RoleTitle" class="form-control form-control-sm" required />
                    </td>
                    <td style="width: 110px;">
                        <input type="number" name="yearsExperience" value="@p.YearsExperience" class="form-control form-control-sm" required />
                    </td>
                    <td>
                        <select name="teamId" class="form-select form-select-sm">
                            <option value="">-- None --</option>
                            @foreach (var t in teams)
                            {
                                if (p.TeamID == t.TeamID)
                                {
                                    <option value="@t.TeamID" selected>@t.TeamName</option>
                                }
                                else
                                {
                                    <option value="@t.TeamID">@t.TeamName</option>
                                }
                            }
                        </select>
                    </td>
                    <td class="d-flex gap-1">
                        <button type="submit" formaction="@Url.Action("UpdatePrincipal", "Home")" class="btn btn-warning btn-sm">Update</button>
                        <button type="submit" formaction="@Url.Action("DeletePrincipal", "Home")" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this principal?');">Delete</button>
                    </td>
                </form>
            </tr>
        }
    </tbody>
</table>