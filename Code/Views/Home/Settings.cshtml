@model MinorProject4.AppSettings
@{
    ViewData["Title"] = "Settings";
}

<h2 class="mb-3">User Settings</h2>

<div class="card p-4 @(Model.DarkMode ? "bg-secondary text-white border-light" : "bg-white")" style="max-width: 450px;">
    <form method="post" asp-action="ToggleTheme">
        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="darkModeSwitch" name="darkMode" value="true" @(Model.DarkMode ? "checked" : "") />
            <label class="form-check-label" for="darkModeSwitch">Enable Dark Mode</label>
        </div>
        <button type="submit" class="btn btn-primary">Save Settings</button>
    </form>
</div>