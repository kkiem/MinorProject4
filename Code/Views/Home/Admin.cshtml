@model List<MinorProject4.Models.Team>
@inject MinorProject4.AppSettings Settings
@{
    ViewData["Title"] = "Admin - Teams";
    string cardClass = Settings.DarkMode ? "bg-secondary text-white border-light" : "bg-white";
}

<h2 class="mb-3">🛠️ Admin Panel - Manage F1 Teams</h2>
<p class="text-muted">Admin-only page for creating, updating, and deleting Constructor Teams.</p>

<!-- Add New Team Form -->
<div class="card p-3 mb-4 @cardClass">
    <h5>➕ Add New Team</h5>
    <form method="post" asp-action="AddTeam" class="row g-2">
        <div class="col-md-4">
            <input type="text" name="teamName" class="form-control" placeholder="Team Name" required />
        </div>
        <div class="col-md-3">
            <input type="text" name="baseCountry" class="form-control" placeholder="Base Country" required />
        </div>
        <div class="col-md-3">
            <input type="text" name="engineSupplier" class="form-control" placeholder="Engine Supplier" required />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-success w-100">Add Team</button>
        </div>
    </form>
</div>

<!-- Teams Table -->
<table class="table table-bordered table-striped @(Settings.DarkMode ? "table-dark" : "")">
    <thead>
        <tr>
            <th>ID</th>
            <th>Team Name</th>
            <th>Base Country</th>
            <th>Engine Supplier</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.TeamID</td>
                <form method="post">
                    <input type="hidden" name="teamId" value="@t.TeamID" />
                    <td>
                        <input type="text" name="teamName" value="@t.TeamName" class="form-control form-control-sm" required />
                    </td>
                    <td>
                        <input type="text" name="baseCountry" value="@t.BaseCountry" class="form-control form-control-sm" required />
                    </td>
                    <td>
                        <input type="text" name="engineSupplier" value="@t.EngineSupplier" class="form-control form-control-sm" required />
                    </td>
                    <td class="d-flex gap-1">
                        <button type="submit" formaction="@Url.Action("UpdateTeam", "Home")" class="btn btn-warning btn-sm">Update</button>
                        <button type="submit" formaction="@Url.Action("DeleteTeam", "Home")" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this team?');">Delete</button>
                    </td>
                </form>
            </tr>
        }
    </tbody>
</table>